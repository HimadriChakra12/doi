[Unit]
Description=doid — doi notification daemon
Documentation=man:doid(1)
# Start after the graphical session is up (DISPLAY/DBUS_SESSION_BUS_ADDRESS set)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# %h expands to the user's home directory; avoids hard-coding paths
ExecStart=%h/.local/bin/doid
Restart=on-failure
RestartSec=1

# Redirect logs to the systemd journal (in addition to doi's own log file)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
